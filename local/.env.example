STAGE=local
TABLE=dadjokes
# STORE=memory runs without Docker (jokes are lost when pnpm dev stops).
# STORE=dynamodb uses DynamoDB Local on DDB_ENDPOINT (pnpm local:tables first).
STORE=memory
DDB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Ports sit beside Pantry's (8787/8788/5173) and OurToDos' (8797/8798/5174).
API_PORT=8807
# LLM_MODE=fixture answers with canned jokes; LLM_MODE=bedrock calls JOKE_MODEL through the
# local AWS profile.
LLM_MODE=fixture
JOKE_MODEL=us.anthropic.claude-sonnet-4-6
AI_DAILY_CAP=500
