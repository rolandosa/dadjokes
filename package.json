{
  "name": "dadjokes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false -p packages/core && tsc --noEmit --pretty false -p packages/data && tsc --noEmit --pretty false -p packages/api && tsc --noEmit --pretty false -p infra && tsc --noEmit --pretty false -p scripts && tsc --noEmit --pretty false -p local && tsc --noEmit --pretty false -p packages/web",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:api": "tsx watch --env-file=local/.env.local local/dev-server.ts",
    "dev:web": "pnpm --filter @dadjokes/web dev",
    "local:tables": "tsx --env-file=local/.env.local scripts/local-tables.ts",
    "aws:synth": "pnpm --filter @dadjokes/web build && pnpm --filter @dadjokes/infra exec cdk synth --quiet",
    "aws:deploy": "pnpm --filter @dadjokes/web build && pnpm --filter @dadjokes/infra exec cdk deploy --require-approval broadening",
    "qr": "tsx scripts/qr.ts",
    "vault:build": "pnpm --filter @dadjokes/vault run package",
    "vault:deploy": "./scripts/vault-deploy.sh",
    "prod:dedupe": "tsx scripts/dedupe-jokes.ts",
    "prod:reverse-ratings": "tsx scripts/reverse-ratings.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1137.0",
    "@aws-sdk/client-dynamodb": "3.1137.0",
    "@aws-sdk/lib-dynamodb": "3.1137.0",
    "@dadjokes/api": "workspace:*",
    "@dadjokes/core": "workspace:*",
    "@dadjokes/data": "workspace:*",
    "@types/node": "22.10.5",
    "@types/qrcode": "1.5.6",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
